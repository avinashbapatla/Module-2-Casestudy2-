<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prompt Strategy Comparison"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#1A237E"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etTopic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter topic (e.g., 'Machine Learning')"
        android:text="Machine Learning"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnZeroShot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Zero-Shot"
            android:backgroundTint="#2196F3"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnFewShot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Few-Shot"
            android:backgroundTint="#4CAF50"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnStructured"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Structured"
            android:backgroundTint="#FF9800"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear"
            android:backgroundTint="#F44336"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:text="Results will appear here..."
        android:textSize="14sp"
        android:scrollbars="vertical"
        android:maxLines="20"
        android:elevation="2dp"/>

    <TextView
        android:id="@+id/tvComparison"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="#E3F2FD"
        android:padding="16dp"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:textColor="#1A237E"
        android:fontFamily="monospace"
        android:elevation="2dp"/>

</LinearLayout>